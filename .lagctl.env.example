WEB_CONTAINER=lagmedical_web
DB_CONTAINER=lagmedical_db
BACKUP_FILE=database/backups/local/database-full.sql
ASSETS_BACKUP_FILE=database/backups/local/assets.tar.gz

# Database credentials are centralized in Laravel's .env:
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_ROOT_PASSWORD=

# Nginx Proxy Manager infrastructure variables:
NPM_ADMIN_URL=http://127.0.0.1:81
NPM_HTTP_PORT=80
NPM_ADMIN_PORT=81
NPM_HTTPS_PORT=443
NPM_DISABLE_IPV6=true
NPM_IP_RANGES_FETCH_ENABLED=false
NPM_DATA_PATH=./docker/infra/npm/data
NPM_LETSENCRYPT_PATH=./docker/infra/npm/letsencrypt

# Deployment variables:
GIT_REPOSITORY=git@github.com:manueldevlagmedicalinc/lagmedical-bagistro.git
GIT_BRANCH=main
APP_PATH=
